# Firebase: Console > Projectinstellingen > Je apps > Web-app > SDK-configuratie
# In Vercel: Settings > Environment Variables (Production + Preview + Development)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push-certificaat: Console > Cloud Messaging > Web-configuratie.
# Zonder deze sleutel blijft de knop om meldingen aan te zetten verborgen.
VITE_FIREBASE_VAPID_KEY=

# PHP-proxy endpoints (optioneel, laat leeg voor de productie-defaults).
# Handig om naar een test-map te wijzen tijdens ontwikkeling.
VITE_CHECKOUT_URL=https://internedata.nl/uploads/cashmettrash/checkout.php
VITE_STRIPE_PROXY_URL=https://internedata.nl/uploads/cashmettrash/stripe-proxy.php
VITE_PUSH_URL=https://internedata.nl/uploads/cashmettrash/push.php

# Routeplanner: gratis sleutel via openrouteservice.org (Sign up > Dashboard >
# Request a token, profiel "Standaard"). Zonder sleutel blijft de kaart werken,
# maar tekent de app geen route.
VITE_ORS_API_KEY=

# LET OP: de Stripe secret key hoort NIET hier en niet in Vercel.
# Die staat uitsluitend in checkout.php op internedata.nl.
